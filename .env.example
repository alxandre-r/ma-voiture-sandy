# Copy to .env.local and fill in the values from Supabase → Project Settings → API.

# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret, server only: bypasses RLS. Used by lib/supabase/admin.ts
# (sign-up, account deletion, family join and member admin routes). Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
